{
  "project": "HIM-SHIELD",
  "component": "Model 2 \u2014 Dynamic Risk Engine",
  "static_component": {
    "input": "static_landslide_susceptibility",
    "source_model": "Random Forest",
    "threshold": 0.4
  },
  "dynamic_inputs": {
    "rainfall_source": "CHIRPS Daily",
    "soil_moisture_source": "NASA SMAP Daily Soil Moisture",
    "rainfall_windows_days": [
      1,
      3,
      15
    ]
  },
  "rainfall_trigger": {
    "used_windows": {
      "3_day": 0.6,
      "15_day": 0.4
    },
    "note": "The 1-day rainfall value is retained as current rainfall context. The dynamic rainfall trigger uses the 3-day and 15-day windows."
  },
  "dynamic_trigger": {
    "rainfall_weight": 0.7,
    "soil_moisture_weight": 0.3
  },
  "risk_engine": {
    "formula": "current_landslide_risk = static_landslide_susceptibility * (1 + 0.50 * dynamic_trigger_score)",
    "clipping": "[0, 1]"
  },
  "risk_categories": {
    "Low": "< 0.20",
    "Moderate": "0.20 <= risk < 0.40",
    "High": "0.40 <= risk < 0.60",
    "Very High": ">= 0.60"
  },
  "fallbacks": {
    "missing_smap_cells": 216,
    "smap_fallback": "Observed median soil-moisture value",
    "missing_rainfall_reference_cells": 78,
    "rainfall_reference_fallback": "Global median annual rainfall"
  },
  "important_note": "These risk thresholds and weights are project operational prototype rules and are not validated statewide disaster-warning thresholds."
}